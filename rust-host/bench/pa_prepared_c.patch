+void
+extruder_prepare_pressure_advance(struct stepper_kinematics *sk, struct trapq *q)
+{
+    struct extruder_stepper *es = container_of(sk, struct extruder_stepper, sk);
+    if (!es->half_smooth_time)
+        return;
+    struct list_head *schedule = &es->pa_list;
+    struct pa_params *pa = list_first_entry(schedule, struct pa_params, node);
+    struct move *m;
+    list_for_each_entry(m, &q->moves, node) {
+        while (!list_is_last(&pa->node, schedule)) {
+            struct pa_params *next = list_next_entry(pa, node);
+            if (next->active_print_time > m->print_time)
+                break;
+            pa = next;
+        }
+        double gain = m->axes_r.y != 0. ? pa->pressure_advance : 0.;
+        double v = m->start_v + gain * 2. * m->half_accel;
+        m->pa_base_shift = gain * m->start_v;
+        m->pa_half_v = .5 * v;
+        m->pa_third_v = (1. / 3.) * v;
+        m->pa_third_a = (1. / 3.) * m->half_accel;
+        m->pa_quarter_a = .25 * m->half_accel;
+    }
+}
